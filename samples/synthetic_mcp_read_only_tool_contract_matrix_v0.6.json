{
  "schema_version": "mcp_read_only_tool_contract_matrix.v0.6",
  "planning_only": true,
  "runtime_registry_implemented": false,
  "read_only_first": true,
  "allowlist_tools_only": true,
  "verify_first_requirement": true,
  "raw_data_included": false,
  "allowed_candidate_tools": [
    "get_gateway_status",
    "list_verified_outputs",
    "get_live_capture_status",
