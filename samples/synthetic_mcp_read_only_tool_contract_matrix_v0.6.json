    "get_report_readiness",
    "get_prompt_readiness",
    "get_troubleshooting_categories",
    "get_release_readiness"
  ],
  "forbidden_tool_concepts": [
    "get_raw_request",
    "get_raw_response",
    "read_local_only_file",
    "read_raw_vault",
    "replay_request",
    "active_scan",
    "send_to_chatgpt",
    "delete_files",
    "show_hmac_secret",
    "show_csrf_token",
    "modify_burp_config",
    "collaborator_payload_send"
  ],
