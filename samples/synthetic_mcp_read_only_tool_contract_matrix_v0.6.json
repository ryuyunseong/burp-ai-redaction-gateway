    "not_allowlisted",
    "raw_access_blocked",
    "state_change_blocked",
    "local_path_blocked",
    "secret_access_blocked"
  ],
  "safe_file_allowlist": [
    "analysis_packet.json",
    "chatgpt_prompt.md",
    "codex_task_prompt.md",
    "report_draft.md"
  ],
  "boundaries": {
    "no_raw_traffic": true,
    "no_automatic_chatgpt_handoff": true,
    "candidate_finding_only": true,
    "risk_draft_only": true,
    "final_severity_cvss_manual_decision": true,
    "no_state_changing_tools": true
  }
}
